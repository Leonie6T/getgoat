# Copy to .env.local for local development. Never commit real values.

# Neon Postgres (Vercel adds these when you connect the Neon integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Session signing key: at least 32 random characters
AUTH_SECRET=

# Seller login. Set SELLER_PASSWORD, or SELLER_PASSWORD_HASH (npm run hash-password -- 'your password')
SELLER_EMAIL=
SELLER_PASSWORD=
SELLER_PASSWORD_HASH=
