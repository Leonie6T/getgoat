generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Sex {
  BUCK
  DOE
  WETHER
}

enum IdMarkType {
  TATTOO
  BRAND
  EAR_TAG
}

enum Pregnancy {
  YES
  NO
  UNKNOWN
}

enum GoatStatus {
  AVAILABLE
  RESERVED
  SOLD
  COLLECTED
  HIDDEN
}

enum MediaKind {
  PHOTO
  VIDEO
}

enum OrderStatus {
  PENDING
  PAID
  COLLECTED
  CANCELLED
  EXPIRED
  REFUND_NEEDED
  REFUNDED
}

/// Single row: the business selling goats.
model Seller {
  id                String   @id @default(cuid())
  businessName      String
  companyRegNo      String?
  repName           String?
  repIdNumberEnc    String?
  farmName          String?
  farmAddress       String?
  cellphone         String
  email             String?
  idMark            String?
  idMarkRegNo       String?
  signatureImageUrl String?
  updatedAt         DateTime @updatedAt
}

model Goat {
  id            String      @id @default(cuid())
  code          String      @unique
  breed         String
  sex           Sex
  ageMonths     Int?
  weightKg      Decimal?    @db.Decimal(5, 1)
  colour        String?
  idMarkType    IdMarkType
  idMarkValue   String
  priceCents    Int
  notes         String?
  pregnant      Pregnancy?
  dueMonth      String?
  hasKidded     Boolean?
  kiddingCount  Int?
  status        GoatStatus  @default(AVAILABLE)
  reservedUntil DateTime?
  media         GoatMedia[]
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
}

model GoatMedia {
  id           String    @id @default(cuid())
  goatId       String
  goat         Goat      @relation(fields: [goatId], references: [id], onDelete: Cascade)
  kind         MediaKind
  cloudinaryId String
  sortOrder    Int       @default(0)

  @@index([goatId, sortOrder])
}

model Buyer {
  id          String   @id @default(cuid())
  fullName    String
  idNumberEnc String
  cellphone   String
  address     String
  email       String?
  orders      Order[]
  createdAt   DateTime @default(now())
}

model Order {
  id                String      @id @default(cuid())
  number            Int         @unique @default(autoincrement())
  buyerId           String
  buyer             Buyer       @relation(fields: [buyerId], references: [id])
  totalCents        Int
  status            OrderStatus @default(PENDING)
  driverName        String?
  driverIdNumberEnc String?
  vehicleReg        String?
  consentAt         DateTime
  payfastPaymentId  String?
  paidAt            DateTime?
  collectedAt       DateTime?
  documentUrl       String?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
}

/// v1: exactly one item per order. v2: cart.
model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  goatId     String
  goat       Goat   @relation(fields: [goatId], references: [id])
  priceCents Int

  @@unique([orderId, goatId])
}
